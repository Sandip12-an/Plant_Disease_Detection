# Environment Configuration Template

# General App Settings
PROJECT_NAME="Plant Disease Detection System"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Host and Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (Defaults to SQLite for local development; use PostgreSQL for production)
DATABASE_URL="sqlite:///./plant_disease.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plant_disease_db"

# Storage Settings
STORAGE_TYPE="local" # "local" or "s3"
UPLOAD_DIR="./uploads"

# AWS S3 Settings (Optional, required only if STORAGE_TYPE="s3")
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="plant-disease-scans"

# ML Model Configuration
MODEL_PATH="ml/model_registry/mobilenet_v2_v1.onnx"
CLASS_LABELS_PATH="ml/model_registry/class_labels.json"
DISEASE_DATA_PATH="backend/app/db/seed_data/diseases_data.json"
CONFIDENCE_THRESHOLD=0.60
